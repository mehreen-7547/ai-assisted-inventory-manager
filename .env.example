# Copy this file to .env. Never commit your real .env.
DJANGO_SECRET_KEY=replace-with-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite is the agreed local database for now.
# Change DB_ENGINE to mysql later only after explicitly approving the switch.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# Used only if DB_ENGINE=mysql (requires a separate MySQL driver).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
